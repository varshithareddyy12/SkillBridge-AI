# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Aiven PostgreSQL or local PostgreSQL)
# For Aiven PostgreSQL, include ?sslmode=require
DATABASE_URL=postgresql://avnadmin:YOUR_PASSWORD@your-aiven-pg-host.aivencloud.com:12345/defaultdb?sslmode=require

# Authentication
JWT_SECRET=super-secret-jwt-key-change-this-in-production-skillbridge-2026
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# CORS & Frontend Origins
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://skillbridge-ai.vercel.app

# Upload Constraints
MAX_FILE_SIZE=5242880
UPLOAD_DIR=./uploads
